# OurHome 環境變數範本
# ---------------------------------------------------------------------------
# 用法：複製成 .env 再填入實際值。.env 已被 .gitignore 排除，不會進版控。
#
# ⚠️ 正式環境（Render）請在 Dashboard → Environment 設定，不要依賴 .env。
#    python-dotenv 的 load_dotenv() 預設 override=False，
#    因此平台環境變數的優先權高於 .env 檔案內容。
# ---------------------------------------------------------------------------

# 租屋模式：couple = 雙人同住 (預設 400 度電) / single = 單人居住 (200 度電)
# 這個值會同時影響費用估算與爬蟲的坪數/關鍵字過濾門檻
MODE=couple

# 591 搜尋結果頁網址，可設 TARGET_URL_1 ~ TARGET_URL_50
# 也可以用單一 TARGET_URL，多條網址以逗號或分號分隔
TARGET_URL_1=https://rent.591.com.tw/list?region=1&kind=2&shape=2
TARGET_URL_2=

# Discord Webhook（留空則只在 log 印出模擬通知，不會實際發送）
DISCORD_WEBHOOK_URL=

# GitHub Personal Access Token，供雲端把 rentals_backup.json 寫回 repo
# 本地開發通常不需要；沒有 token 時只會寫本地檔案，不會呼叫 GitHub API
GITHUB_TOKEN=

# 巡邏間隔（分鐘）
CHECK_INTERVAL_MINUTES=10

# SQLite 資料庫檔名
DB_PATH=rentals.db

# ── 通勤時間 ───────────────────────────────────────────────────
# 完全離線估算，不需要任何 API 金鑰、不會產生費用。
# 系統會從房源標題找出最近的捷運站，再用內建的台北捷運路網算最短路徑。
# 目的地填捷運站名，以逗號分隔，可設多個。
COMMUTE_DESTINATIONS=南京復興,南港軟體園區
